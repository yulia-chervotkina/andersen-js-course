{
  "parser": "babel-eslint",
  "env": {
    "browser": true
  },
  "extends": ["airbnb-base", "prettier"],
  "plugins": ["prettier"],
  "rules": {
    "prettier/prettier": ["error"],
    "no-param-reassign": ["error", { "props": false }],
    "no-plusplus": "off",
    "class-methods-use-this": "off",
    "no-alert": "off",
    "no-return-assign": "off"
  }
}